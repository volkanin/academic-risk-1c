// Модуль сериализации расширения АР_АналитикаРиска: запись JSON, ответы
// HTTP-сервиса и приведение значений к строкам витрин. Даты передаются
// строками ISO 8601 без часового пояса (время сеанса).

// Режим отладки: в ответах с кодом 500 возвращается подробное описание
// ошибки платформы. Перед выходом в промышленную эксплуатацию
// переключить в Ложь: тексты внутренних исключений наружу не отдаются,
// сведения остаются в журнале регистрации.
Функция РежимОтладки() Экспорт

	Возврат Истина;

КонецФункции

// ---------- Приведение значений ----------

// Строковый идентификатор ссылки (UUID) или исходная строка; для пустого
// значения пустая строка.
Функция Идентификатор(Знач Значение) Экспорт

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат XMLСтрока(Значение);

КонецФункции

// Строковое представление ссылки (наименование элемента); для пустого
// значения пустая строка.
Функция Представление(Знач Значение) Экспорт

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

// Дата строкой yyyy-MM-dd; для пустой даты пустая строка.
Функция ДатаСтрокой(Знач Дата) Экспорт

	Если Не ЗначениеЗаполнено(Дата) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Формат(Дата, "ДФ=""yyyy-MM-dd""");

КонецФункции

// Дата и время строкой yyyy-MM-ddTHH:mm:ss.
Функция ДатаВремяСтрокой(Знач Дата) Экспорт

	Если Не ЗначениеЗаполнено(Дата) Тогда
		Возврат "";
	КонецЕсли;
	Возврат ДатаСтрокой(Дата) + "T" + Формат(Дата, "ДФ=""HH:mm:ss""");

КонецФункции

// Разбор даты ISO 8601 из параметра запроса. Возвращает Ложь, если строка
// не является датой; в Дата записывается пустая дата.
Функция ДатаИзСтроки(Знач Значение, Дата) Экспорт

	Дата = '00010101';
	Текст = СокрЛП(Значение);
	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрДлина(Текст) = 10 Тогда
		Текст = Текст + "T00:00:00";
	КонецЕсли;
	Попытка
		Дата = XMLЗначение(Тип("Дата"), Текст);
	Исключение
		Дата = '00010101';
		Возврат Ложь;
	КонецПопытки;
	Возврат ЗначениеЗаполнено(Дата);

КонецФункции

// Целое число строкой фиксированной ширины: нужно для устойчивого
// строкового порядка ключей (10 идет после 9).
Функция ТекстЧисла(Знач Число) Экспорт

	Текст = Формат(Число, "ЧГ=0");
	Пока СтрДлина(Текст) < 10 Цикл
		Текст = "0" + Текст;
	КонецЦикла;
	Возврат Текст;

КонецФункции

// ---------- JSON ----------

Функция СтрокаJSON(Знач Объект) Экспорт

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, "", Истина));
	ЗаписатьJSON(Запись, Объект);
	Возврат Запись.Закрыть();

КонецФункции

// Чтение JSON в соответствие: отсутствующие поля не вызывают ошибок.
// При ошибке разбора возвращается Неопределено.
Функция ОбъектИзJSON(Знач Текст) Экспорт

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Попытка
		Результат = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Результат = Неопределено;
	КонецПопытки;
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

// ---------- Ответы ----------

Функция ОтветJSON(Знач КодСостояния, Знач Объект) Экспорт

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON(Объект), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;

КонецФункции

Функция ЭлементОшибки(Знач КодОшибки, Знач Сообщение) Экспорт

	Возврат Новый Структура("code, message", КодОшибки, Сообщение);

КонецФункции

Функция ОтветОшибки(Знач КодСостояния, Знач Ошибки) Экспорт

	Если ТипЗнч(Ошибки) = Тип("Структура") Тогда
		СписокОшибок = Новый Массив;
		СписокОшибок.Добавить(Ошибки);
	Иначе
		СписокОшибок = Ошибки;
	КонецЕсли;
	Оболочка = Новый Структура("data, meta, errors", Неопределено, Неопределено, СписокОшибок);
	Возврат ОтветJSON(КодСостояния, Оболочка);

КонецФункции

// Ответ на исключение в обработчике: сведения в журнал регистрации,
// клиенту код 500 и машинночитаемый код ошибки. Текст сведений готовит
// сам обработчик в своем блоке Исключение: из вызываемой процедуры
// платформа отдает только текст «Непредвиденная ошибка».
Функция ОтветИсключения(Знач ИмяМетода, Знач Сведения) Экспорт

	ЗаписьЖурналаРегистрации("АР_Аналитика." + ИмяМетода, УровеньЖурналаРегистрации.Ошибка, , , Сведения);
	Если РежимОтладки() Тогда
		Сообщение = Сведения;
	Иначе
		Сообщение = "Внутренняя ошибка сервиса, сведения записаны в журнал регистрации";
	КонецЕсли;
	Возврат ОтветОшибки(500, ЭлементОшибки("internalError", Сообщение));

КонецФункции
