// Модуль витрин расширения АР_АналитикаРиска: сборка витрин со срезом на
// дату, потока событий и соответствия зачетных книжек. Контракты описаны
// в docs/1c_enhancements_tz.md, источники в docs/metadata-mapping.md.
//
// Пагинация курсорная: строки сортируются по строковому ключу, курсор
// содержит ключ последней строки выданной страницы. Курсор кодируется
// Base64 и непрозрачен для клиента. Методы с диапазоном дат читают записи
// диапазона; задолженности читают предысторию по задетым ключам.
// Методы ничего не пишут в информационную базу.

// ---------- Ссылки, даты ----------

Функция Идентификатор(Знач Значение)

	Возврат АР_Сериализация.Идентификатор(Значение);

КонецФункции

Функция Представление(Знач Значение)

	Возврат АР_Сериализация.Представление(Значение);

КонецФункции

Функция ДатаСтрокой(Знач Дата)

	Возврат АР_Сериализация.ДатаСтрокой(Дата);

КонецФункции

Функция ТекстЧисла(Знач Число)

	Возврат АР_Сериализация.ТекстЧисла(Число);

КонецФункции

Функция ДатаВДиапазоне(Знач Дата, Знач ДатаС, Знач ДатаПо)

	Возврат ЗначениеЗаполнено(Дата) И Дата >= ДатаС И Дата <= ДатаПо;

КонецФункции

// ---------- Курсор и страницы ----------

Функция КлючВКурсор(Знач Ключ)

	// Base64, устойчивый к передаче в адресе: платформа переносит строку
	// по 76 символов, переносы убираются, плюс и слеш заменены
	Данные = ПолучитьДвоичныеДанныеИзСтроки(Ключ, КодировкаТекста.UTF8);
	СтрокаBase64 = ПолучитьBase64СтрокуИзДвоичныхДанных(Данные);
	СтрокаBase64 = СтрЗаменить(СтрЗаменить(СтрокаBase64, Символы.ВК, ""), Символы.ПС, "");
	Возврат СтрЗаменить(СтрЗаменить(СтрокаBase64, "+", "-"), "/", "_");

КонецФункции

Функция КурсорВКлюч(Знач Курсор)

	Текст = СокрЛП(Курсор);
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;
	Текст = СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, ""), " ", "");
	Текст = СтрЗаменить(СтрЗаменить(Текст, "-", "+"), "_", "/");
	Пока СтрДлина(Текст) % 4 <> 0 Цикл
		Текст = Текст + "=";
	КонецЦикла;
	Возврат ПолучитьСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзBase64Строки(Текст), КодировкаТекста.UTF8);

КонецФункции

// Проверка курсора: пустой курсор допустим, поврежденный нет.
Функция КурсорДействителен(Знач Курсор) Экспорт

	Если ПустаяСтрока(Курсор) Тогда
		Возврат Истина;
	КонецЕсли;
	Попытка
		Возврат Не ПустаяСтрока(КурсорВКлюч(Курсор));
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Колонка со строковым ключом из значений перечисленных колонок.
Процедура ДобавитьКлюч(Таблица, Знач ИмяКолонкиРезультата, Знач Колонки, Знач Разделитель)

	Таблица.Колонки.Добавить(ИмяКолонкиРезультата, Новый ОписаниеТипов("Строка"));
	ИменаКолонок = СтрРазделить(Колонки, ",", Ложь);
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Части = Новый Массив;
		Для Каждого ИмяКолонки Из ИменаКолонок Цикл
			Значение = СтрокаТаблицы[ИмяКолонки];
			Если ТипЗнч(Значение) = Тип("Число") Тогда
				Части.Добавить(ТекстЧисла(Значение));
			Иначе
				Части.Добавить(Идентификатор(Значение));
			КонецЕсли;
		КонецЦикла;
		СтрокаТаблицы[ИмяКолонкиРезультата] = СтрСоединить(Части, Разделитель);
	КонецЦикла;

КонецПроцедуры

// Строки таблицы после курсора в порядке возрастания КлючСтроки. В Строки
// помещается массив строк страницы. Возвращается курсор следующей страницы
// или пустая строка, если строки закончились.
Функция СтраницаТаблицы(Таблица, Знач Курсор, Знач Лимит, Строки)

	Таблица.Сортировать("КлючСтроки Возр");
	КлючПосл = КурсорВКлюч(Курсор);
	Строки = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если ЗначениеЗаполнено(КлючПосл) И СтрокаТаблицы.КлючСтроки <= КлючПосл Тогда
			Продолжить;
		КонецЕсли;
		Если Строки.Количество() >= Лимит Тогда
			Возврат КлючВКурсор(Строки[Строки.Количество() - 1].КлючСтроки);
		КонецЕсли;
		Строки.Добавить(СтрокаТаблицы);
	КонецЦикла;
	Возврат "";

КонецФункции

// Общая оболочка ответа: data, meta, errors.
Функция Оболочка(Данные, Знач СледующийКурсор, Знач ДатаСреза) Экспорт

	Мета = Новый Структура;
	Мета.Вставить("count", Данные.Количество());
	Мета.Вставить("nextCursor", ?(ПустаяСтрока(СледующийКурсор), Неопределено, СледующийКурсор));
	Мета.Вставить("asOf", ДатаСтрокой(ДатаСреза));
	Мета.Вставить("schemaVersion", "1");

	Ответ = Новый Структура("data, meta, errors", Данные, Мета, Новый Массив);
	Возврат Ответ;

КонецФункции

// ---------- dim/students ----------

// У студента с несколькими зачетными книгами остается одна запись
// (порядок устойчивый: по ссылкам).
Процедура ОставитьОднуЗаписьНаСтудента(Таблица)

	Таблица.Сортировать("ФизическоеЛицо Возр, ЗачетнаяКнига Возр, НачальнаяЗачетнаяКнига Возр");
	Видимые = Новый Соответствие;
	Лишние = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если Видимые[СтрокаТаблицы.ФизическоеЛицо] = Неопределено Тогда
			Видимые.Вставить(СтрокаТаблицы.ФизическоеЛицо, Истина);
		Иначе
			Лишние.Добавить(СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Лишняя Из Лишние Цикл
		Таблица.Удалить(Лишняя);
	КонецЦикла;

КонецПроцедуры

Функция ВитринаStudents(Знач ДатаСреза, Знач Курсор, Знач Лимит) Экспорт

	Таблица = АР_АдаптерМетаданных.СостоянияНаДату(ДатаСреза);
	ОставитьОднуЗаписьНаСтудента(Таблица);
	ДобавитьКлюч(Таблица, "КлючСтроки", "ФизическоеЛицо", "|");

	Строки = Неопределено;
	СледующийКурсор = СтраницаТаблицы(Таблица, Курсор, Лимит, Строки);

	Данные = Новый Массив;
	Для Каждого СтрокаСостояния Из Строки Цикл
		Запись = Новый Структура;
		Запись.Вставить("student_id", Идентификатор(СтрокаСостояния.ФизическоеЛицо));
		Запись.Вставить("book_number", Представление(СтрокаСостояния.ЗачетнаяКнига));
		Запись.Вставить("program_id", Идентификатор(СтрокаСостояния.УчебныйПлан));
		Запись.Вставить("group_code", Представление(СтрокаСостояния.Группа));
		Запись.Вставить("faculty", Представление(СтрокаСостояния.Факультет));
		Запись.Вставить("study_form", Представление(СтрокаСостояния.ФормаОбучения));
		Запись.Вставить("basis", Представление(СтрокаСостояния.Основа));
		Запись.Вставить("gender", Представление(СтрокаСостояния.Пол));
		Запись.Вставить("birth_date", ДатаСтрокой(СтрокаСостояния.ДатаРождения));
		Запись.Вставить("region", Представление(СтрокаСостояния.Регион));
		Запись.Вставить("hostel", Неопределено);
		Запись.Вставить("privilege", Неопределено);
		Запись.Вставить("state", Представление(СтрокаСостояния.Состояние));
		Данные.Добавить(Запись);
	КонецЦикла;

	Возврат Оболочка(Данные, СледующийКурсор, ДатаСреза);

КонецФункции

