		Запись.Вставить("book_number", Представление(СтрокаВедомости.ЗачетнаяКнига));
		Запись.Вставить("program_id", Идентификатор(СтрокаВедомости.УчебныйПлан));
		Запись.Вставить("discipline_id", Идентификатор(СтрокаВедомости.Дисциплина));
		Запись.Вставить("discipline_title", Представление(СтрокаВедомости.Дисциплина));
