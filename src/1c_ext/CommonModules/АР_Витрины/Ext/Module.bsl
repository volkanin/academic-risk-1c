// ---------- dim/disciplines и fact/load ----------
//
// Источник: записи учебного плана из документов учебных планов.
// program_id это документ учебного плана, на который ссылаются студенты
// (program_id в dim/students), discipline_id это дисциплина справочника,
// как в fact/grades. Зачетные единицы берутся из части «ЗЕТ по
// дисциплинам»; при их отсутствии вычисляются: часы семестра, деленные
// на количество часов в зачетной единице (свойство учебного плана).

Функция ВитринаDisciplines(Знач ДатаСреза, Знач Курсор, Знач Лимит) Экспорт

	Таблица = АР_АдаптерМетаданных.ЗаписиПланов();
	СДисциплиной = Новый Массив;
	Для Каждого СтрокаПлана Из Таблица Цикл
		Если ЗначениеЗаполнено(СтрокаПлана.Дисциплина) Тогда
			СДисциплиной.Добавить(СтрокаПлана);
		КонецЕсли;
	КонецЦикла;
	Таблица = Таблица.Скопировать(СДисциплиной);

	ЕдиницыДисциплин = Новый Соответствие;
	Для Каждого СтрокаЗЕТ Из АР_АдаптерМетаданных.ЗачетныеЕдиницыПланов() Цикл
		Ключ = Идентификатор(СтрокаЗЕТ.Ссылка) + "|" + СтрокаЗЕТ.ИдентификаторУзла + "|"
			+ Идентификатор(СтрокаЗЕТ.ПериодКонтроля);
		ЕдиницыДисциплин.Вставить(Ключ, СтрокаЗЕТ.ЗачетныхЕдиниц);
	КонецЦикла;

	ДобавитьКлюч(Таблица, "КлючСтроки", "Ссылка,ИдентификаторСтроки", "|");

	Строки = Неопределено;
	СледующийКурсор = СтраницаТаблицы(Таблица, Курсор, Лимит, Строки);

	Данные = Новый Массив;
	Для Каждого СтрокаПлана Из Строки Цикл
		Ключ = Идентификатор(СтрокаПлана.Ссылка) + "|" + СтрокаПлана.ИдентификаторУзла + "|"
			+ Идентификатор(СтрокаПлана.ПериодКонтроля);
		Запись = Новый Структура;
		Запись.Вставить("program_id", Идентификатор(СтрокаПлана.Ссылка));
		Запись.Вставить("discipline_id", Идентификатор(СтрокаПлана.Дисциплина));
		Запись.Вставить("discipline_title", Представление(СтрокаПлана.Дисциплина));
		Запись.Вставить("row_id", Идентификатор(СтрокаПлана.ИдентификаторСтроки));
		Запись.Вставить("semester", Представление(СтрокаПлана.ПериодКонтроля));
		Запись.Вставить("load_type", Представление(СтрокаПлана.Нагрузка));
		Запись.Вставить("unit", Представление(СтрокаПлана.ЕдиницаИзмерения));
		Запись.Вставить("amount", СтрокаПлана.Количество);
		Запись.Вставить("credits", ЕдиницыДисциплин[Ключ]);
		Данные.Добавить(Запись);
	КонецЦикла;

	Возврат Оболочка(Данные, СледующийКурсор, ДатаСреза);

КонецФункции

// Нагрузка семестра учебного плана: дисциплины семестра, часы, число
// дисциплин с экзаменом, зачетом и курсовой работой (проектом), зачетные
// единицы.
Функция ВитринаLoad(Знач ДатаСреза, Знач Курсор, Знач Лимит) Экспорт

	ЧасовВЗЕТ = Новый Соответствие;
	Для Каждого СтрокаПлана Из АР_АдаптерМетаданных.УчебныеПланы() Цикл
		ЧасовВЗЕТ.Вставить(Идентификатор(СтрокаПлана.Ссылка), СтрокаПлана.ЧасовВЗЕТ);
	КонецЦикла;

	ЕдиницыСеместра = Новый Соответствие;
	Для Каждого СтрокаЗЕТ Из АР_АдаптерМетаданных.ЗачетныеЕдиницыПланов() Цикл
		Ключ = Идентификатор(СтрокаЗЕТ.Ссылка) + "|" + Идентификатор(СтрокаЗЕТ.ПериодКонтроля);
		Сумма = ?(ЕдиницыСеместра[Ключ] = Неопределено, 0, ЕдиницыСеместра[Ключ]);
		ЕдиницыСеместра.Вставить(Ключ, Сумма + СтрокаЗЕТ.ЗачетныхЕдиниц);
	КонецЦикла;

	Нагрузка = Новый ТаблицаЗначений;
	Нагрузка.Колонки.Добавить("program_id", Новый ОписаниеТипов("Строка"));
	Нагрузка.Колонки.Добавить("semester", Новый ОписаниеТипов("Строка"));
	Нагрузка.Колонки.Добавить("n_disciplines", Новый ОписаниеТипов("Число"));
	Нагрузка.Колонки.Добавить("hours", Новый ОписаниеТипов("Число"));
	Нагрузка.Колонки.Добавить("n_exams", Новый ОписаниеТипов("Число"));
	Нагрузка.Колонки.Добавить("n_tests", Новый ОписаниеТипов("Число"));
	Нагрузка.Колонки.Добавить("n_course_works", Новый ОписаниеТипов("Число"));
	Нагрузка.Колонки.Добавить("hours_per_credit", Новый ОписаниеТипов("Число"));
	Нагрузка.Колонки.Добавить("credits", Новый ОписаниеТипов("Число"));
	Нагрузка.Колонки.Добавить("credits_source", Новый ОписаниеТипов("Строка"));

	Для Каждого СтрокаНагрузки Из АР_АдаптерМетаданных.НагрузкаПланов() Цикл
		СтрокаРезультата = Нагрузка.Добавить();
		СтрокаРезультата.program_id = Идентификатор(СтрокаНагрузки.Ссылка);
		СтрокаРезультата.semester = Представление(СтрокаНагрузки.ПериодКонтроля);
		СтрокаРезультата.n_disciplines = СтрокаНагрузки.Дисциплин;
		СтрокаРезультата.hours = СтрокаНагрузки.Часов;
		СтрокаРезультата.n_exams = СтрокаНагрузки.Экзаменов;
		СтрокаРезультата.n_tests = СтрокаНагрузки.Зачетов;
		СтрокаРезультата.n_course_works = СтрокаНагрузки.Курсовых;
		Норма = ЧасовВЗЕТ[СтрокаРезультата.program_id];
		СтрокаРезультата.hours_per_credit = Норма;
		Единицы = ЕдиницыСеместра[СтрокаРезультата.program_id + "|" + Идентификатор(СтрокаНагрузки.ПериодКонтроля)];
		Если Единицы <> Неопределено Тогда
			СтрокаРезультата.credits = Единицы;
			СтрокаРезультата.credits_source = "plan";
		ИначеЕсли Норма <> Неопределено И Норма > 0 Тогда
			СтрокаРезультата.credits = Окр(СтрокаРезультата.hours / Норма, 1);
			СтрокаРезультата.credits_source = "calculated";
		КонецЕсли;
	КонецЦикла;

	ДобавитьКлюч(Нагрузка, "КлючСтроки", "program_id,semester", "|");

	Строки = Неопределено;
	СледующийКурсор = СтраницаТаблицы(Нагрузка, Курсор, Лимит, Строки);

	Данные = Новый Массив;
	Для Каждого СтрокаНагрузки Из Строки Цикл
		Запись = Новый Структура;
		Запись.Вставить("program_id", СтрокаНагрузки.program_id);
		Запись.Вставить("semester", СтрокаНагрузки.semester);
		Запись.Вставить("n_disciplines", СтрокаНагрузки.n_disciplines);
		Запись.Вставить("hours", СтрокаНагрузки.hours);
		Запись.Вставить("n_exams", СтрокаНагрузки.n_exams);
		Запись.Вставить("n_tests", СтрокаНагрузки.n_tests);
		Запись.Вставить("n_course_works", СтрокаНагрузки.n_course_works);
		Запись.Вставить("hours_per_credit", СтрокаНагрузки.hours_per_credit);
		Запись.Вставить("credits", СтрокаНагрузки.credits);
		Запись.Вставить("credits_source", СтрокаНагрузки.credits_source);
		Данные.Добавить(Запись);
	КонецЦикла;

	Возврат Оболочка(Данные, СледующийКурсор, ДатаСреза);

КонецФункции

// ---------- fact/movements ----------

Функция ВитринаMovements(Знач ДатаС, Знач ДатаПо, Знач Курсор, Знач Лимит) Экспорт

	Таблица = АР_АдаптерМетаданных.Приказы(ДатаС, ДатаПо);
	ДобавитьКлюч(Таблица, "КлючСтроки", "Ссылка,НомерСтроки", ":");

	Строки = Неопределено;
	СледующийКурсор = СтраницаТаблицы(Таблица, Курсор, Лимит, Строки);

	Данные = Новый Массив;
	Для Каждого СтрокаПриказа Из Строки Цикл
		Запись = Новый Структура;
		Запись.Вставить("student_id", Идентификатор(СтрокаПриказа.ФизическоеЛицо));
		Запись.Вставить("book_number", Представление(СтрокаПриказа.ЗачетнаяКнига));
		Запись.Вставить("order_type", Представление(СтрокаПриказа.ТипПриказа));
		Запись.Вставить("order_kind", Представление(СтрокаПриказа.ВидПриказа));
		Запись.Вставить("reason", Представление(СтрокаПриказа.Причина));
		Запись.Вставить("analytics", Представление(СтрокаПриказа.Аналитика));
		Запись.Вставить("order_date", ДатаСтрокой(СтрокаПриказа.ДатаПриказа));
		Запись.Вставить("effective_date", ДатаСтрокой(?(ЗначениеЗаполнено(СтрокаПриказа.ДатаОтчисления),
			СтрокаПриказа.ДатаОтчисления, СтрокаПриказа.ДатаНачала)));
		Запись.Вставить("program_id", Идентификатор(СтрокаПриказа.УчебныйПлан));
		Запись.Вставить("group_code", Представление(СтрокаПриказа.Группа));
		Запись.Вставить("entered_at", Неопределено);
		Данные.Добавить(Запись);
	КонецЦикла;

	Возврат Оболочка(Данные, СледующийКурсор, ДатаПо);

КонецФункции

// ---------- Оценки и задолженности ----------

Функция ПорядокКлючаОценки()

	Возврат "КлючОценки Возр, ДатаКонтроля Возр, ДатаДокумента Возр, Ссылка Возр, НомерСтроки Возр";

КонецФункции

Процедура ДобавитьКлючОценки(Таблица)

	ДобавитьКлюч(Таблица, "КлючОценки", "ФизическоеЛицо,УчебныйПлан,Дисциплина,ПериодКонтроля", "|");

КонецПроцедуры

// Отрицательная отметка: неудовлетворительно, незачет, неявка.
Функция ОтрицательнаяОценка(Знач Оценка)

	Текст = ВРег(СокрЛП(Оценка));
	Возврат Текст = "2"
		Или СтрНайти(Текст, "НЕУДОВЛЕТВОР") > 0
		Или СтрНайти(Текст, "НЕЗАЧ") > 0
		Или СтрНайти(Текст, "НЕ ЗАЧТ") > 0
		Или СтрНайти(Текст, "НЕЯВ") > 0
		Или СтрНайти(Текст, "НЕ ЯВИЛ") > 0;

КонецФункции

Функция ЭтоНеявка(Знач Оценка)

	Текст = ВРег(СокрЛП(Оценка));
	Возврат СтрНайти(Текст, "НЕЯВ") > 0 Или СтрНайти(Текст, "НЕ ЯВИЛ") > 0;

КонецФункции

// Номер попытки: порядковый номер ведомости по ключу оценки в порядке
// дат контроля.
Процедура ЗаполнитьНомерПопытки(Таблица)

	ДобавитьКлючОценки(Таблица);
	Таблица.Колонки.Добавить("Попытка", Новый ОписаниеТипов("Число"));
	Таблица.Сортировать(ПорядокКлючаОценки());

	ПредыдущийКлюч = "";
	Номер = 0;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если СтрокаТаблицы.КлючОценки <> ПредыдущийКлюч Тогда
			Номер = 0;
		КонецЕсли;
		Номер = Номер + 1;
		ПредыдущийКлюч = СтрокаТаблицы.КлючОценки;
		СтрокаТаблицы.Попытка = Номер;
	КонецЦикла;

КонецПроцедуры

Функция ВитринаGrades(Знач ДатаС, Знач ДатаПо, Знач Курсор, Знач Лимит) Экспорт

