КонецФункции

// Долги из строк ведомостей: отрицательная отметка открывает долг,
// следующая положительная отметка по тому же ключу закрывает. Таблица
// должна содержать полную историю по каждому ключу. Возвращается таблица
// строк открытия с датой и ведомостью закрытия.
Функция ДолгиИзВедомостей(Таблица)

	ДобавитьКлючОценки(Таблица);
	Таблица.Колонки.Добавить("ДатаЗакрытия", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("СсылкаЗакрытия", Таблица.Колонки.Ссылка.ТипЗначения);
	Таблица.Колонки.Добавить("НомерСтрокиЗакрытия", Новый ОписаниеТипов("Число"));
	Таблица.Сортировать(ПорядокКлючаОценки());

	Долги = Новый Массив;
	ПредыдущийКлюч = "";
	ОткрытаяСтрока = Неопределено;
	Для Каждого СтрокаВедомости Из Таблица Цикл
		Если СтрокаВедомости.КлючОценки <> ПредыдущийКлюч И ОткрытаяСтрока <> Неопределено Тогда
			Долги.Добавить(ОткрытаяСтрока);
			ОткрытаяСтрока = Неопределено;
		КонецЕсли;
		ПредыдущийКлюч = СтрокаВедомости.КлючОценки;

		Оценка = Представление(СтрокаВедомости.Отметка);
		Если ПустаяСтрока(Оценка) Тогда
			Продолжить;
		КонецЕсли;
		Если ОтрицательнаяОценка(Оценка) Тогда
			Если ОткрытаяСтрока = Неопределено Тогда
				ОткрытаяСтрока = СтрокаВедомости;
			КонецЕсли;
		ИначеЕсли ОткрытаяСтрока <> Неопределено Тогда
			ОткрытаяСтрока.ДатаЗакрытия = СтрокаВедомости.ДатаКонтроля;
			ОткрытаяСтрока.СсылкаЗакрытия = СтрокаВедомости.Ссылка;
			ОткрытаяСтрока.НомерСтрокиЗакрытия = СтрокаВедомости.НомерСтроки;
			Долги.Добавить(ОткрытаяСтрока);
			ОткрытаяСтрока = Неопределено;
		КонецЕсли;
	КонецЦикла;
	Если ОткрытаяСтрока <> Неопределено Тогда
		Долги.Добавить(ОткрытаяСтрока);
	КонецЕсли;

	Возврат Таблица.Скопировать(Долги);

КонецФункции

// Долги, возникшие или закрытые в диапазоне дат.
Функция ВитринаDebts(Знач ДатаС, Знач ДатаПо, Знач Курсор, Знач Лимит) Экспорт

	Долги = ДолгиИзВедомостей(АР_АдаптерМетаданных.ВедомостиПоКлючамОкна(ДатаС, ДатаПо));

	ВДиапазоне = Новый Массив;
	Для Каждого Долг Из Долги Цикл
		Если ДатаВДиапазоне(Долг.ДатаКонтроля, ДатаС, ДатаПо) Или ДатаВДиапазоне(Долг.ДатаЗакрытия, ДатаС, ДатаПо) Тогда
			ВДиапазоне.Добавить(Долг);
		КонецЕсли;
	КонецЦикла;
	Таблица = Долги.Скопировать(ВДиапазоне);
	ДобавитьКлюч(Таблица, "КлючСтроки", "Ссылка,НомерСтроки", ":");

	Строки = Неопределено;
	СледующийКурсор = СтраницаТаблицы(Таблица, Курсор, Лимит, Строки);

	Данные = Новый Массив;
	Для Каждого Долг Из Строки Цикл
		Запись = Новый Структура;
		Запись.Вставить("student_id", Идентификатор(Долг.ФизическоеЛицо));
		Запись.Вставить("book_number", Представление(Долг.ЗачетнаяКнига));
		Запись.Вставить("program_id", Идентификатор(Долг.УчебныйПлан));
		Запись.Вставить("discipline_id", Идентификатор(Долг.Дисциплина));
		Запись.Вставить("discipline_title", Представление(Долг.Дисциплина));
		Запись.Вставить("semester", Представление(Долг.ПериодКонтроля));
		Запись.Вставить("arose_date", ДатаСтрокой(Долг.ДатаКонтроля));
		Запись.Вставить("closed_date", ?(ЗначениеЗаполнено(Долг.ДатаЗакрытия), ДатаСтрокой(Долг.ДатаЗакрытия), Неопределено));
		Запись.Вставить("event_id_open", "debt-open:" + Идентификатор(Долг.Ссылка) + ":" + ТекстЧисла(Долг.НомерСтроки));
		Данные.Добавить(Запись);
	КонецЦикла;

	Возврат Оболочка(Данные, СледующийКурсор, ДатаПо);

КонецФункции

// ---------- Оплаты и поток событий ----------

// Оплата по договорам: дата документа это фактическая дата платежа,
// дата оплаты по графику это плановая дата.
Функция ОписаниеОплаты(СтрокаОплаты)

	Просрочка = 0;
	Если ЗначениеЗаполнено(СтрокаОплаты.ДатаПоГрафику) И ЗначениеЗаполнено(СтрокаОплаты.ДатаДокумента) Тогда
		Просрочка = Цел((СтрокаОплаты.ДатаДокумента - СтрокаОплаты.ДатаПоГрафику) / 86400);
		Если Просрочка < 0 Тогда
			Просрочка = 0;
		КонецЕсли;
	КонецЕсли;

	ЭтоФизЛицо = ТипЗнч(СтрокаОплаты.ФизическоеЛицо) = Тип("СправочникСсылка.ФизическиеЛица");
	Оплата = Новый Структура;
	Оплата.Вставить("student_id", ?(ЭтоФизЛицо, Идентификатор(СтрокаОплаты.ФизическоеЛицо), ""));
	Оплата.Вставить("contract_id", Идентификатор(СтрокаОплаты.Договор));
	Оплата.Вставить("amount", СтрокаОплаты.Сумма);
	Оплата.Вставить("paid_date", ДатаСтрокой(СтрокаОплаты.ДатаДокумента));
	Оплата.Вставить("accrual_date", ?(ЗначениеЗаполнено(СтрокаОплаты.ДатаПоГрафику),
		ДатаСтрокой(СтрокаОплаты.ДатаПоГрафику), Неопределено));
	Оплата.Вставить("overdue_days", Просрочка);
	Оплата.Вставить("entered_at", Неопределено);
	Оплата.Вставить("event_id", "payment:" + Идентификатор(СтрокаОплаты.Ссылка));
	Возврат Оплата;

КонецФункции

Функция ВитринаFinance(Знач ДатаС, Знач ДатаПо, Знач Курсор, Знач Лимит) Экспорт

	Таблица = АР_АдаптерМетаданных.Оплаты(ДатаС, ДатаПо);
	ДобавитьКлюч(Таблица, "КлючСтроки", "Ссылка", ":");

	Строки = Неопределено;
	СледующийКурсор = СтраницаТаблицы(Таблица, Курсор, Лимит, Строки);

	Данные = Новый Массив;
	Для Каждого СтрокаОплаты Из Строки Цикл
		Данные.Добавить(ОписаниеОплаты(СтрокаОплаты));
	КонецЦикла;

	Возврат Оболочка(Данные, СледующийКурсор, ДатаПо);

КонецФункции

Функция ТаблицаСобытий()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("event_id", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("kind", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("student_id", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("occurred_at", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("payload");
	Возврат Таблица;

КонецФункции

Процедура ДобавитьСобытие(Таблица, Знач ИдентификаторСобытия, Знач ВидСобытия, Знач ИдентификаторСтудента,
	Знач ДатаСобытия, Знач ПолезнаяНагрузка)

	СтрокаСобытия = Таблица.Добавить();
	СтрокаСобытия.event_id = ИдентификаторСобытия;
	СтрокаСобытия.kind = ВидСобытия;
	СтрокаСобытия.student_id = ИдентификаторСтудента;
	СтрокаСобытия.occurred_at = ДатаСобытия;
	СтрокаСобытия.payload = ПолезнаяНагрузка;

КонецПроцедуры

// События диапазона дат: оценки, возникновение и закрытие задолженностей,
// оплаты. Идентификаторы событий производные от записей источников и не
// меняются при повторной выгрузке.
Функция События(Знач ДатаС, Знач ДатаПо, Знач Курсор, Знач Лимит) Экспорт

	Таблица = ТаблицаСобытий();

	Для Каждого СтрокаВедомости Из АР_АдаптерМетаданных.Ведомости(ДатаС, ДатаПо) Цикл
		ПолезнаяНагрузка = Новый Структура;
		ПолезнаяНагрузка.Вставить("discipline_id", Идентификатор(СтрокаВедомости.Дисциплина));
		ПолезнаяНагрузка.Вставить("discipline_title", Представление(СтрокаВедомости.Дисциплина));
		ПолезнаяНагрузка.Вставить("semester", Представление(СтрокаВедомости.ПериодКонтроля));
		ПолезнаяНагрузка.Вставить("grade", Представление(СтрокаВедомости.Отметка));
		ДобавитьСобытие(Таблица,
			"grade:" + Идентификатор(СтрокаВедомости.Ссылка) + ":" + ТекстЧисла(СтрокаВедомости.НомерСтроки),
			"grade", Идентификатор(СтрокаВедомости.ФизическоеЛицо),
			ДатаСтрокой(СтрокаВедомости.ДатаКонтроля), ПолезнаяНагрузка);
	КонецЦикла;

	Для Каждого Долг Из ДолгиИзВедомостей(АР_АдаптерМетаданных.ВедомостиПоКлючамОкна(ДатаС, ДатаПо)) Цикл
		ПолезнаяНагрузка = Новый Структура;
		ПолезнаяНагрузка.Вставить("discipline_id", Идентификатор(Долг.Дисциплина));
		ПолезнаяНагрузка.Вставить("discipline_title", Представление(Долг.Дисциплина));
		ПолезнаяНагрузка.Вставить("semester", Представление(Долг.ПериодКонтроля));
		ПолезнаяНагрузка.Вставить("arose_date", ДатаСтрокой(Долг.ДатаКонтроля));
		ПолезнаяНагрузка.Вставить("closed_date", ?(ЗначениеЗаполнено(Долг.ДатаЗакрытия), ДатаСтрокой(Долг.ДатаЗакрытия), Неопределено));
		Если ДатаВДиапазоне(Долг.ДатаКонтроля, ДатаС, ДатаПо) Тогда
			ДобавитьСобытие(Таблица,
				"debt-open:" + Идентификатор(Долг.Ссылка) + ":" + ТекстЧисла(Долг.НомерСтроки),
				"debt_open", Идентификатор(Долг.ФизическоеЛицо), ДатаСтрокой(Долг.ДатаКонтроля), ПолезнаяНагрузка);
		КонецЕсли;
		Если ДатаВДиапазоне(Долг.ДатаЗакрытия, ДатаС, ДатаПо) Тогда
			ДобавитьСобытие(Таблица,
				"debt-closed:" + Идентификатор(Долг.СсылкаЗакрытия) + ":" + ТекстЧисла(Долг.НомерСтрокиЗакрытия),
				"debt_closed", Идентификатор(Долг.ФизическоеЛицо), ДатаСтрокой(Долг.ДатаЗакрытия), ПолезнаяНагрузка);
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаОплаты Из АР_АдаптерМетаданных.Оплаты(ДатаС, ДатаПо) Цикл
		Оплата = ОписаниеОплаты(СтрокаОплаты);
		ПолезнаяНагрузка = Новый Структура;
		ПолезнаяНагрузка.Вставить("amount", Оплата.amount);
		ПолезнаяНагрузка.Вставить("accrual_date", Оплата.accrual_date);
		ПолезнаяНагрузка.Вставить("overdue_days", Оплата.overdue_days);
		ДобавитьСобытие(Таблица, Оплата.event_id, "payment", Оплата.student_id, Оплата.paid_date, ПолезнаяНагрузка);
	КонецЦикла;

	ДобавитьКлюч(Таблица, "КлючСтроки", "occurred_at,event_id", "|");

	Строки = Неопределено;
	СледующийКурсор = СтраницаТаблицы(Таблица, Курсор, Лимит, Строки);

	Данные = Новый Массив;
	Для Каждого СтрокаСобытия Из Строки Цикл
		Событие = Новый Структура;
		Событие.Вставить("event_id", СтрокаСобытия.event_id);
		Событие.Вставить("kind", СтрокаСобытия.kind);
		Событие.Вставить("student_id", СтрокаСобытия.student_id);
		Событие.Вставить("occurred_at", СтрокаСобытия.occurred_at);
		Событие.Вставить("payload", СтрокаСобытия.payload);
		Данные.Добавить(Событие);
	КонецЦикла;

	Возврат Оболочка(Данные, СледующийКурсор, ДатаПо);

КонецФункции

// ---------- /mapping/students-books ----------

// Соответствие физлица и номера зачетной книги (наименование справочника
// равно логину СЭО). Состояние справочное, для отбора действующих.
Функция СоответствиеКнижек(Знач ДатаСреза, Знач Курсор, Знач Лимит) Экспорт

	Таблица = АР_АдаптерМетаданных.СостоянияНаДату(ДатаСреза);
	ДобавитьКлюч(Таблица, "КлючСтроки", "ФизическоеЛицо,ЗачетнаяКнига,НачальнаяЗачетнаяКнига", "|");

	Строки = Неопределено;
	СледующийКурсор = СтраницаТаблицы(Таблица, Курсор, Лимит, Строки);

	Данные = Новый Массив;
	Для Каждого СтрокаСостояния Из Строки Цикл
		Запись = Новый Структура;
		Запись.Вставить("student_id", Идентификатор(СтрокаСостояния.ФизическоеЛицо));
		Запись.Вставить("book_number", Представление(СтрокаСостояния.ЗачетнаяКнига));
		Запись.Вставить("student_state", Представление(СтрокаСостояния.Состояние));
		Данные.Добавить(Запись);
	КонецЦикла;

	Возврат Оболочка(Данные, СледующийКурсор, ДатаСреза);

КонецФункции
