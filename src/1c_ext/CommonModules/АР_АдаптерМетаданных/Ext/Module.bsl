// Модуль-адаптер метаданных расширения АР_АналитикаРиска.
//
// Единственное место, где указаны имена объектов типовой конфигурации
// 1С:Университет ПРОФ (УниверситетПРОФ_2_2, версия 2.3.2.28). При смене
// релиза правки затрагивают только этот модуль. Соответствие предметных
// полей объектам описано в docs/metadata-mapping.md.
//
// Функции возвращают таблицы значений с исходными ссылками и датами.
// Представления, идентификаторы и JSON формируют модули АР_Витрины
// и АР_Сериализация. Методы чтения не меняют данные информационной базы.

// Строки ведомости: документ, номер строки, даты, ключи студента, плана,
// дисциплины и периода контроля, отметка. Дата контроля это дата занятия,
// а при её отсутствии дата документа.
Функция ПоляВедомостей() Экспорт

	Возврат "Стр.Ссылка КАК Ссылка,
	|	Стр.НомерСтроки КАК НомерСтроки,
	|	Стр.Ссылка.Дата КАК ДатаДокумента,
	|	ВЫБОР
	|		КОГДА Стр.Ссылка.ДатаЗанятия = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА Стр.Ссылка.Дата
	|		ИНАЧЕ Стр.Ссылка.ДатаЗанятия
	|	КОНЕЦ КАК ДатаКонтроля,
	|	Стр.Ссылка.Дисциплина КАК Дисциплина,
	|	Стр.Ссылка.ПериодКонтроля КАК ПериодКонтроля,
	|	Стр.Ссылка.ВидКонтроля КАК ВидКонтроля,
	|	Стр.ФизическоеЛицо КАК ФизическоеЛицо,
	|	Стр.ЗачетнаяКнига КАК ЗачетнаяКнига,
	|	Стр.УчебныйПлан КАК УчебныйПлан,
	|	Стр.Отметка КАК Отметка";

КонецФункции

// Диапазон дат контроля ведомостей.
Функция УсловиеДатВедомостей() Экспорт

	Возврат "ВЫБОР
	|		КОГДА Стр.Ссылка.ДатаЗанятия = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА Стр.Ссылка.Дата
	|		ИНАЧЕ Стр.Ссылка.ДатаЗанятия
	|	КОНЕЦ МЕЖДУ &ДатаС И &ДатаПо";

КонецФункции

// Состояния студентов на дату среза: последняя запись регистра по каждому
// сочетанию физлицо, зачетная книга, начальная зачетная книга.
//
// Реквизит Регион справочника физических лиц может отсутствовать в
// конфигурации базы данных (основная конфигурация обновлена, структура
// таблиц еще нет). В этом случае запрос выполняется без региона, а колонка
// Регион добавляется в результат пустой.
Функция СостоянияНаДату(Знач ДатаСреза) Экспорт

	Попытка
		Таблица = ЗапросСостояний(ДатаСреза, Истина).Выполнить().Выгрузить();
	Исключение
		Если СтрНайти(ОписаниеОшибки(), "Поле не найдено") = 0 Тогда
			ВызватьИсключение;
		КонецЕсли;
		Таблица = ЗапросСостояний(ДатаСреза, Ложь).Выполнить().Выгрузить();
		Таблица.Колонки.Добавить("Регион", Новый ОписаниеТипов("Строка"));
	КонецПопытки;
	Возврат Таблица;

КонецФункции

Функция ЗапросСостояний(Знач ДатаСреза, Знач СРегионом)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сост.ФизическоеЛицо КАК ФизическоеЛицо,
	|	Сост.ЗачетнаяКнига КАК ЗачетнаяКнига,
	|	Сост.НачальнаяЗачетнаяКнига КАК НачальнаяЗачетнаяКнига,
	|	Сост.УчебныйПлан КАК УчебныйПлан,
	|	Сост.Группа КАК Группа,
	|	Сост.Факультет КАК Факультет,
	|	Сост.ФормаОбучения КАК ФормаОбучения,
	|	Сост.Основа КАК Основа,
	|	Сост.Состояние КАК Состояние,
	|	Физ.ДатаРождения КАК ДатаРождения,
	|	Физ.Пол КАК Пол"
		+ ?(СРегионом, ",
	|	Физ.Регион КАК Регион", "")
		+ "
	|ИЗ
	|	РегистрСведений.СостояниеСтудентов.СрезПоследних(&ДатаСреза) КАК Сост
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК Физ
	|		ПО Сост.ФизическоеЛицо = Физ.Ссылка";
	Запрос.УстановитьПараметр("ДатаСреза", КонецДня(ДатаСреза));
	Возврат Запрос;

КонецФункции

// Приказы по движению контингента: строки табличной части ОбщиеДанные
// проведенных документов в диапазоне дат приказа.
Функция Приказы(Знач ДатаС, Знач ДатаПо) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Стр.Ссылка КАК Ссылка,
	|	Стр.НомерСтроки КАК НомерСтроки,
	|	Стр.Ссылка.Дата КАК ДатаПриказа,
	|	Стр.ФизическоеЛицо КАК ФизическоеЛицо,
	|	Стр.ЗачетнаяКнига КАК ЗачетнаяКнига,
	|	Стр.ТипПриказа КАК ТипПриказа,
	|	Стр.ВидПриказа КАК ВидПриказа,
	|	Стр.Причина КАК Причина,
	|	Стр.Аналитика КАК Аналитика,
	|	Стр.ДатаНачала КАК ДатаНачала,
	|	Стр.ДатаОтчисления КАК ДатаОтчисления,
	|	Стр.УчебныйПлан КАК УчебныйПлан,
	|	Стр.Группа КАК Группа
	|ИЗ
	|	Документ.Приказы.ОбщиеДанные КАК Стр
	|ГДЕ
	|	Стр.Ссылка.Проведен
	|	И Стр.Ссылка.Дата МЕЖДУ &ДатаС И &ДатаПо";
	Запрос.УстановитьПараметр("ДатаС", ДатаС);
	Запрос.УстановитьПараметр("ДатаПо", ДатаПо);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Строки ведомостей (история попыток) в диапазоне дат контроля.
Функция Ведомости(Знач ДатаС, Знач ДатаПо) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|" + ПоляВедомостей() + "
	|ИЗ
	|	Документ.Ведомость.ДанныеПоАттестации КАК Стр
	|ГДЕ
	|	Стр.Ссылка.Проведен
	|	И " + УсловиеДатВедомостей();
	Запрос.УстановитьПараметр("ДатаС", ДатаС);
	Запрос.УстановитьПараметр("ДатаПо", ДатаПо);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// История ведомостей по ключам, задетым окном дат. Ключ это студент,
// учебный план, дисциплина и период контроля. Полная история по ключу
// нужна, чтобы отличить первую попытку от пересдачи и найти закрытие
// задолженности, возникшей до начала окна.
Функция ВедомостиПоКлючамОкна(Знач ДатаС, Знач ДатаПо) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Стр.ФизическоеЛицо КАК ФизическоеЛицо,
	|	Стр.УчебныйПлан КАК УчебныйПлан,
	|	Стр.Ссылка.Дисциплина КАК Дисциплина,
	|	Стр.Ссылка.ПериодКонтроля КАК ПериодКонтроля
	|ПОМЕСТИТЬ ВТ_Ключи
	|ИЗ
	|	Документ.Ведомость.ДанныеПоАттестации КАК Стр
	|ГДЕ
	|	Стр.Ссылка.Проведен
	|	И " + УсловиеДатВедомостей() + "
	|ИНДЕКСИРОВАТЬ ПО
	|	ФизическоеЛицо,
	|	УчебныйПлан,
	|	Дисциплина,
	|	ПериодКонтроля;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|" + ПоляВедомостей() + "
	|ИЗ
	|	Документ.Ведомость.ДанныеПоАттестации КАК Стр
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Ключи КАК Ключи
	|		ПО Стр.ФизическоеЛицо = Ключи.ФизическоеЛицо
	|			И Стр.УчебныйПлан = Ключи.УчебныйПлан
	|			И Стр.Ссылка.Дисциплина = Ключи.Дисциплина
	|			И Стр.Ссылка.ПериодКонтроля = Ключи.ПериодКонтроля
	|ГДЕ
	|	Стр.Ссылка.Проведен";
	Запрос.УстановитьПараметр("ДатаС", ДатаС);
	Запрос.УстановитьПараметр("ДатаПо", ДатаПо);
	Результаты = Запрос.ВыполнитьПакет();
	Возврат Результаты[1].Выгрузить();

КонецФункции

// Оплаты по договорам: проведенные документы в диапазоне дат документа.
Функция Оплаты(Знач ДатаС, Знач ДатаПо) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Опл.Ссылка КАК Ссылка,
	|	Опл.Договор КАК Договор,
	|	Опл.Сумма КАК Сумма,
	|	Опл.ФизическоеЛицо КАК ФизическоеЛицо,
	|	Опл.Дата КАК ДатаДокумента,
	|	Опл.ДатаОплатыПоГрафикуПлатежей КАК ДатаПоГрафику
	|ИЗ
	|	Документ.ОплатаПоДоговорам КАК Опл
	|ГДЕ
	|	Опл.Проведен
	|	И Опл.Дата МЕЖДУ &ДатаС И &ДатаПо";
	Запрос.УстановитьПараметр("ДатаС", ДатаС);
	Запрос.УстановитьПараметр("ДатаПо", ДатаПо);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Записи учебного плана: строки одноименной табличной части документов
// учебных планов. ИдентификаторУзла объединяет строки одной дисциплины
// в плане, ИдентификаторСтроки уникален для строки.
Функция ЗаписиПланов() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Стр.Ссылка КАК Ссылка,
	|	Стр.УникальныйИдентификаторСтроки КАК ИдентификаторСтроки,
	|	Стр.УникальныйИдентификатор КАК ИдентификаторУзла,
	|	Стр.Дисциплина КАК Дисциплина,
	|	Стр.ПериодКонтроля КАК ПериодКонтроля,
	|	Стр.Нагрузка КАК Нагрузка,
	|	Стр.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Стр.Количество КАК Количество
	|ИЗ
	|	Документ.УчебныйПлан.ЗаписиУчебногоПлана КАК Стр";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Зачетные единицы по дисциплинам планов: суммируются по учебному плану,
// узлу дисциплины и периоду контроля.
Функция ЗачетныеЕдиницыПланов() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Стр.Ссылка КАК Ссылка,
	|	Стр.УникальныйИдентификатор КАК ИдентификаторУзла,
	|	Стр.ПериодКонтроля КАК ПериодКонтроля,
	|	СУММА(Стр.КоличествоЗЕТ) КАК ЗачетныхЕдиниц
	|ИЗ
	|	Документ.УчебныйПлан.ЗЕТПоДисциплинам КАК Стр
	|СГРУППИРОВАТЬ ПО
	|	Стр.Ссылка,
	|	Стр.УникальныйИдентификатор,
	|	Стр.ПериодКонтроля";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Нагрузка семестра учебного плана запросом: число дисциплин, часы,
// число дисциплин с экзаменом, зачетом и курсовой работой (проектом).
// Виды контроля и нагрузки отбираются по наименованию справочников.
Функция НагрузкаПланов() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Спр.Ссылка КАК Ссылка ПОМЕСТИТЬ ВТ_Часы
	|ИЗ Справочник.ЕдиницыИзмерения КАК Спр
	|ГДЕ Спр.Наименование = ""Часы"";
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ Спр.Ссылка КАК Ссылка ПОМЕСТИТЬ ВТ_Экзамены
	|ИЗ Справочник.ВидыКонтроля КАК Спр
	|ГДЕ Спр.Наименование ПОДОБНО ""%экзам%""
	|ОБЪЕДИНИТЬ
	|ВЫБРАТЬ Спр.Ссылка
	|ИЗ Справочник.ВидыНагрузки КАК Спр
	|ГДЕ Спр.Наименование ПОДОБНО ""%экзам%"";
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ Спр.Ссылка КАК Ссылка ПОМЕСТИТЬ ВТ_Зачеты
	|ИЗ Справочник.ВидыКонтроля КАК Спр
	|ГДЕ Спр.Наименование ПОДОБНО ""%зачет%""
	|ОБЪЕДИНИТЬ
	|ВЫБРАТЬ Спр.Ссылка
	|ИЗ Справочник.ВидыНагрузки КАК Спр
	|ГДЕ Спр.Наименование ПОДОБНО ""%зачет%"";
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ Спр.Ссылка КАК Ссылка ПОМЕСТИТЬ ВТ_Курсовые
	|ИЗ Справочник.ВидыКонтроля КАК Спр
	|ГДЕ Спр.Наименование ПОДОБНО ""%курсов%""
	|ОБЪЕДИНИТЬ
	|ВЫБРАТЬ Спр.Ссылка
	|ИЗ Справочник.ВидыНагрузки КАК Спр
	|ГДЕ Спр.Наименование ПОДОБНО ""%курсов%"";
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Стр.Ссылка КАК Ссылка,
	|	Стр.ПериодКонтроля КАК ПериодКонтроля,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Стр.Дисциплина) КАК Дисциплин,
	|	СУММА(ВЫБОР КОГДА Часы.Ссылка ЕСТЬ НЕ NULL ТОГДА Стр.Количество ИНАЧЕ 0 КОНЕЦ) КАК Часов,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР КОГДА Экзамены.Ссылка ЕСТЬ НЕ NULL ТОГДА Стр.Дисциплина КОНЕЦ) КАК Экзаменов,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР КОГДА Зачеты.Ссылка ЕСТЬ НЕ NULL ТОГДА Стр.Дисциплина КОНЕЦ) КАК Зачетов,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР КОГДА Курсовые.Ссылка ЕСТЬ НЕ NULL ТОГДА Стр.Дисциплина КОНЕЦ) КАК Курсовых
	|ИЗ
	|	Документ.УчебныйПлан.ЗаписиУчебногоПлана КАК Стр
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Часы КАК Часы
	|			ПО Стр.ЕдиницаИзмерения = Часы.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Экзамены КАК Экзамены
	|			ПО Стр.Нагрузка = Экзамены.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Зачеты КАК Зачеты
	|			ПО Стр.Нагрузка = Зачеты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Курсовые КАК Курсовые
	|			ПО Стр.Нагрузка = Курсовые.Ссылка
	|ГДЕ
	|	Стр.Дисциплина ЕСТЬ НЕ NULL
	|СГРУППИРОВАТЬ ПО
	|	Стр.Ссылка,
	|	Стр.ПериодКонтроля";
	Результаты = Запрос.ВыполнитьПакет();
	Возврат Результаты[4].Выгрузить();

КонецФункции

// Документы учебных планов: программа подготовки.
Функция УчебныеПланы() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	План.Ссылка КАК Ссылка,
	|	План.Специальность КАК Специальность,
	|	План.Факультет КАК Факультет,
	|	План.ФормаОбучения КАК ФормаОбучения,
	|	План.УчебныйГод КАК УчебныйГод,
	|	План.КоличествоЧасовВЗЕТ КАК ЧасовВЗЕТ,
	|	План.ПредставлениеУчебногоПлана КАК ПредставлениеПлана
	|ИЗ
	|	Документ.УчебныйПлан КАК План
	|ГДЕ
	|	НЕ План.ПометкаУдаления";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Справочники метода /reference: имя выхода и справочник типовой
// конфигурации. Перечень фиксирован, имена из запроса не принимаются.
Функция ИменаСправочников() Экспорт

	Возврат Новый Структура("orderTypes, orderKinds, orderAnalytics, marks, controlTypes, studyForms, specialities, personStates",
		"ТипыПриказов", "ВидыПриказов", "АналитикаТиповПриказа", "Отметки", "ВидыКонтроля", "ФормаОбучения",
		"Специальности", "СостоянияФизическихЛиц");

КонецФункции

// Справочник целиком: ссылки и наименования.
Функция СправочникЦеликом(Знач ИмяСправочника) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Спр.Ссылка КАК Ссылка,
	|	Спр.Наименование КАК Наименование
	|ИЗ
	|	Справочник." + ИмяСправочника + " КАК Спр
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции
