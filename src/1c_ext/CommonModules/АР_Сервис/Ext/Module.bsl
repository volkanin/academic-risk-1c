// Модуль сервиса расширения АР_АналитикаРиска: разбор параметров запроса,
// вызов витрин и единые ответы. Обработчики модуля HTTP-сервиса
// делегируют сюда. Маршруты и контракты описаны в docs/1c_enhancements_tz.md.
//
// Методы чтения не меняют данные информационной базы. Запись выполняет
// только POST /v1/scoring/batch, и только в регистр АР_ОценкиРиска.

Функция ВерсияРасширения() Экспорт

	Возврат "1.0.0.1";

КонецФункции

Функция ВерсияСхемы() Экспорт

	Возврат "1";

КонецФункции

// ---------- Параметры запроса ----------

Функция ПараметрЗапроса(Запрос, Знач Имя)

	Возврат СокрЛП(Строка(Запрос.ПараметрыЗапроса.Получить(Имя)));

КонецФункции

// Параметры пагинации и дат: asOf для срезов, dateFrom и dateTo для
// диапазонов. В Ошибка возвращается текст проблемы (код 400).
Функция ПараметрыВыгрузки(Запрос, Знач ЭтоСрез, Ошибка) Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("ДатаСреза", ТекущаяДатаСеанса());
	Параметры.Вставить("ДатаС", '00010101');
	Параметры.Вставить("ДатаПо", '00010101');
	Параметры.Вставить("Курсор", "");
	Параметры.Вставить("Лимит", 10000);
	Ошибка = "";

	Параметры.Курсор = ПараметрЗапроса(Запрос, "cursor");
	Если Не АР_Витрины.КурсорДействителен(Параметры.Курсор) Тогда
		Ошибка = "Параметр cursor поврежден: передайте значение из meta.nextCursor предыдущей страницы";
		Возврат Параметры;
	КонецЕсли;

	ТекстЛимита = ПараметрЗапроса(Запрос, "limit");
	Если ЗначениеЗаполнено(ТекстЛимита) Тогда
		Попытка
			Параметры.Лимит = Цел(Число(ТекстЛимита));
		Исключение
			Ошибка = "Параметр limit должен быть целым положительным числом";
			Возврат Параметры;
		КонецПопытки;
	КонецЕсли;
	Если Параметры.Лимит <= 0 Тогда
		Ошибка = "Параметр limit должен быть целым положительным числом";
		Возврат Параметры;
	ИначеЕсли Параметры.Лимит > 10000 Тогда
		Параметры.Лимит = 10000;
	КонецЕсли;

	Если ЭтоСрез Тогда
		ДатаСреза = '00010101';
		ТекстДаты = ПараметрЗапроса(Запрос, "asOf");
		Если ЗначениеЗаполнено(ТекстДаты) Тогда
			Если АР_Сериализация.ДатаИзСтроки(ТекстДаты, ДатаСреза) Тогда
				Параметры.ДатаСреза = ДатаСреза;
			Иначе
				Ошибка = "Параметр asOf должен быть датой ISO 8601, например 2024-06-30";
			КонецЕсли;
		КонецЕсли;
	Иначе
		ТекстДатыС = ПараметрЗапроса(Запрос, "dateFrom");
		ТекстДатыПо = ПараметрЗапроса(Запрос, "dateTo");
		ДатаС = '00010101';
		ДатаПо = '00010101';
		Если Не ЗначениеЗаполнено(ТекстДатыС) Или Не ЗначениеЗаполнено(ТекстДатыПо) Тогда
			Ошибка = "Обязательные параметры dateFrom и dateTo: даты ISO 8601, например 2024-01-01";
		ИначеЕсли Не АР_Сериализация.ДатаИзСтроки(ТекстДатыС, ДатаС)
			Или Не АР_Сериализация.ДатаИзСтроки(ТекстДатыПо, ДатаПо) Тогда
			Ошибка = "Параметры dateFrom и dateTo должны быть датами ISO 8601";
		ИначеЕсли ДатаС > ДатаПо Тогда
			Ошибка = "dateFrom больше dateTo";
		Иначе
			Параметры.ДатаС = НачалоДня(ДатаС);
			Параметры.ДатаПо = КонецДня(ДатаПо);
		КонецЕсли;
	КонецЕсли;

	Возврат Параметры;

КонецФункции

Функция ОтветНеверныеПараметры(Знач ТекстОшибки)

	Возврат АР_Сериализация.ОтветОшибки(400, АР_Сериализация.ЭлементОшибки("invalidParameters", ТекстОшибки));

КонецФункции

