// ---------- Прием оценок риска ----------

// Проверенная запись оценки или Неопределено (текст проблемы добавляется
// в Проблемы). Даты и ссылки проверяются до записи, поэтому ошибочная
// запись не попадает в набор записей.
Функция ОценкаИзЭлемента(Элемент, Знач ИдентификаторРасчета, Знач ДатаПакета, Знач ЕстьДатаПакета,
	Знач Номер, Проблемы)

	Проблема = "";
	Вероятность = 0;

	ИдентификаторСтудента = СокрЛП(Строка(Элемент["studentId"]));
	Студент = Справочники.ЗачетныеКниги.ПустаяСсылка();
	Если СтрДлина(ИдентификаторСтудента) <> 36 Тогда
		Проблема = "studentId должен быть идентификатором записи справочника зачетных книг";
	Иначе
		Попытка
			Студент = Справочники.ЗачетныеКниги.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдентификаторСтудента));
		Исключение
			Проблема = "studentId должен быть идентификатором записи справочника зачетных книг";
		КонецПопытки;
	КонецЕсли;

	Если ПустаяСтрока(Проблема) Тогда
		Вероятность = Элемент["riskProbability"];
		Если ТипЗнч(Вероятность) <> Тип("Число") Или Вероятность < 0 Или Вероятность > 1 Тогда
			Проблема = "riskProbability должен быть числом от 0 до 1";
		КонецЕсли;
	КонецЕсли;

	ДатаРасчета = ДатаПакета;
	Если ПустаяСтрока(Проблема) Тогда
		Если ЗначениеЗаполнено(Элемент["calculationDate"]) Тогда
			ДатаЭлемента = '00010101';
			Если АР_Сериализация.ДатаИзСтроки(Строка(Элемент["calculationDate"]), ДатаЭлемента) Тогда
				ДатаРасчета = ДатаЭлемента;
			Иначе
				Проблема = "calculationDate должна быть датой ISO 8601";
			КонецЕсли;
		ИначеЕсли Не ЕстьДатаПакета Тогда
			Проблема = "calculationDate не задана ни в записи, ни в пакете";
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(Проблема) Тогда
		Проблемы.Добавить(АР_Сериализация.ЭлементОшибки("invalidItem", "Запись " + Номер + ": " + Проблема));
		Возврат Неопределено;
	КонецЕсли;

	Оценка = Новый Структура;
	Оценка.Вставить("Расчет", ИдентификаторРасчета);
	Оценка.Вставить("Студент", Студент);
	Оценка.Вставить("ДатаРасчета", ДатаРасчета);
	Оценка.Вставить("Вероятность", Вероятность);
	Оценка.Вставить("Категория", Лев(СокрЛП(Строка(Элемент["riskCategory"])), 20));
	Оценка.Вставить("ВерсияМодели", Лев(СокрЛП(Строка(Элемент["modelVersion"])), 20));
	Оценка.Вставить("Факторы", АР_Сериализация.СтрокаJSON(Элемент["factors"]));
	Возврат Оценка;

КонецФункции

// Идемпотентная запись: повторная отправка пакета с тем же calculationId
// заменяет прежний набор расчета. При ошибке хоть в одной записи пакет
// не применяется целиком.
Функция ОценкиРискаПринять(Запрос) Экспорт

	Попытка
		Возврат ОценкиРискаПринятьДанные(Запрос);
	Исключение
		Возврат АР_Сериализация.ОтветИсключения("scoring/batch", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

Функция ОценкиРискаПринятьДанные(Запрос)

	Тело = СокрЛП(Запрос.ПолучитьТелоКакСтроку("UTF-8"));
	Если ПустаяСтрока(Тело) Тогда
		Возврат АР_Сериализация.ОтветОшибки(422, АР_Сериализация.ЭлементОшибки("emptyBody", "Тело запроса пустое"));
	КонецЕсли;

	Пакет = АР_Сериализация.ОбъектИзJSON(Тело);
	Если Пакет = Неопределено Тогда
		Возврат АР_Сериализация.ОтветОшибки(422,
			АР_Сериализация.ЭлементОшибки("invalidBody", "Тело запроса не является корректным JSON"));
	КонецЕсли;
	Если ТипЗнч(Пакет) <> Тип("Соответствие") Тогда
		Возврат АР_Сериализация.ОтветОшибки(422,
			АР_Сериализация.ЭлементОшибки("invalidBody", "Тело запроса должно быть JSON объектом"));
	КонецЕсли;

	ИдентификаторРасчета = СокрЛП(Строка(Пакет["calculationId"]));
	Если ПустаяСтрока(ИдентификаторРасчета) Тогда
		Возврат АР_Сериализация.ОтветОшибки(400,
			АР_Сериализация.ЭлементОшибки("missingCalculationId", "Не задан calculationId"));
	КонецЕсли;
	Если СтрДлина(ИдентификаторРасчета) > 36 Тогда
		Возврат АР_Сериализация.ОтветОшибки(422,
			АР_Сериализация.ЭлементОшибки("invalidCalculationId", "calculationId длиннее 36 символов"));
	КонецЕсли;

	Записи = Пакет["items"];
	Если ТипЗнч(Записи) <> Тип("Массив") Или Записи.Количество() = 0 Тогда
		Возврат АР_Сериализация.ОтветОшибки(422, АР_Сериализация.ЭлементОшибки("emptyItems", "Пакет не содержит записей"));
	КонецЕсли;
	Если Записи.Количество() > 5000 Тогда
		Возврат АР_Сериализация.ОтветОшибки(422,
			АР_Сериализация.ЭлементОшибки("batchTooLarge", "Пакет содержит больше 5000 записей"));
	КонецЕсли;

	ДатаПакета = '00010101';
	ЕстьДатаПакета = Ложь;
	Если ЗначениеЗаполнено(Пакет["calculationDate"]) Тогда
		ЕстьДатаПакета = АР_Сериализация.ДатаИзСтроки(Строка(Пакет["calculationDate"]), ДатаПакета);
	КонецЕсли;

	Проблемы = Новый Массив;
	Набор = РегистрыСведений.АР_ОценкиРиска.СоздатьНаборЗаписей();
	Номер = 0;
	Для Каждого Элемент Из Записи Цикл
		Номер = Номер + 1;
		Если ТипЗнч(Элемент) <> Тип("Соответствие") Тогда
			Проблемы.Добавить(АР_Сериализация.ЭлементОшибки("invalidItem", "Запись " + Номер + ": должна быть JSON объектом"));
			Продолжить;
		КонецЕсли;
		Оценка = ОценкаИзЭлемента(Элемент, ИдентификаторРасчета, ДатаПакета, ЕстьДатаПакета, Номер, Проблемы);
		Если Оценка <> Неопределено Тогда
			ЗаписьНабора = Набор.Добавить();
			ЗаписьНабора.Расчет = Оценка.Расчет;
			ЗаписьНабора.Студент = Оценка.Студент;
			ЗаписьНабора.ДатаРасчета = Оценка.ДатаРасчета;
			ЗаписьНабора.Вероятность = Оценка.Вероятность;
			ЗаписьНабора.Категория = Оценка.Категория;
			ЗаписьНабора.ВерсияМодели = Оценка.ВерсияМодели;
			ЗаписьНабора.Факторы = Оценка.Факторы;
		КонецЕсли;
	КонецЦикла;

	Если Проблемы.Количество() > 0 Тогда
		Возврат АР_Сериализация.ОтветОшибки(422, Проблемы);
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.АР_ОценкиРиска");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Расчет", ИдентификаторРасчета);
		Блокировка.Заблокировать();

		Набор.Отбор.Расчет.Установить(ИдентификаторРасчета);
		Набор.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Данные = Новый Структура("status, calculationId, accepted", "ok", ИдентификаторРасчета, Записи.Количество());
	Возврат АР_Сериализация.ОтветJSON(200, Данные);

КонецФункции

Функция ПоследниеОценкиПолучить(Запрос) Экспорт

	Попытка
		Возврат ПоследниеОценкиПолучитьДанные(Запрос);
	Исключение
		Возврат АР_Сериализация.ОтветИсключения("scoring/latest", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

Функция ПоследниеОценкиПолучитьДанные(Запрос)

	Ошибка = "";
	Параметры = ПараметрыВыгрузки(Запрос, Истина, Ошибка);
	Если ЗначениеЗаполнено(Ошибка) Тогда
		Возврат ОтветНеверныеПараметры(Ошибка);
	КонецЕсли;

	ЗапросОценок = Новый Запрос;
	ЗапросОценок.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Параметры.Лимит, "ЧГ=0") + "
	|	Оценка.Студент КАК Студент,
	|	Оценка.ДатаРасчета КАК ДатаРасчета,
	|	Оценка.Расчет КАК Расчет,
	|	Оценка.Вероятность КАК Вероятность,
	|	Оценка.Категория КАК Категория,
	|	Оценка.ВерсияМодели КАК ВерсияМодели
	|ИЗ
	|	РегистрСведений.АР_ОценкиРиска КАК Оценка
	|УПОРЯДОЧИТЬ ПО
	|	ДатаРасчета Убыв,
	|	Расчет Убыв,
	|	Студент";

	Данные = Новый Массив;
	Выборка = ЗапросОценок.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = Новый Структура;
		Запись.Вставить("studentBookId", АР_Сериализация.Идентификатор(Выборка.Студент));
		Запись.Вставить("calculationDate", АР_Сериализация.ДатаСтрокой(Выборка.ДатаРасчета));
		Запись.Вставить("calculationId", Выборка.Расчет);
		Запись.Вставить("riskProbability", Выборка.Вероятность);
		Запись.Вставить("riskCategory", Выборка.Категория);
		Запись.Вставить("modelVersion", Выборка.ВерсияМодели);
		Данные.Добавить(Запись);
	КонецЦикла;

	Возврат АР_Сериализация.ОтветJSON(200, АР_Витрины.Оболочка(Данные, "", Параметры.ДатаСреза));

КонецФункции
