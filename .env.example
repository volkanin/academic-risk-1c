# Скопировать в .env и подставить свои значения. Файл .env в репозиторий не попадает.

# PostgreSQL (слои raw / cleaned / features / enriched)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=academic_risk
POSTGRES_USER=etl
POSTGRES_PASSWORD=change_me

# Redis (online-хранилище признаков)
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Модель
MODEL_PATH=models/final_model.joblib

# Moodle (внешняя служба чтения; демонстрационный контур: MOODLE_TOKEN не нужен)
MOODLE_URL=
MOODLE_TOKEN=
MOODLE_SALT=change_me

# HTTP-сервис расширения 1С АР_АналитикаРиска (приемник витрин, src/onec_client)
1C_BASE_URL=http://localhost/uni/hs/analytics/v1
1C_USER=ws
1C_PASSWORD=

# Kafka (топик событий успеваемости и оплат)
KAFKA_TOPIC=ar1c.events
